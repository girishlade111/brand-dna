---
const year = new Date().getFullYear();
---

<footer class="pt-16 pb-12 border-t border-[var(--border-subtle)] bg-[var(--surface-raised)] transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    <!-- Main Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 font-mono-ui text-xs">
      <!-- Col 1: Identity & Thesis -->
      <div class="md:col-span-5 space-y-4">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 bg-[var(--foreground)] inline-block"></span>
          <span class="tracking-[0.18em] uppercase font-bold text-[var(--foreground)]">
            BRAND DNA <span class="text-[var(--accent)]">//</span> THE INVISIBLE INSTRUMENT
          </span>
        </div>
        <p class="font-editorial-body text-xs text-[var(--muted)] leading-relaxed max-w-sm">
          Deterministic brand design system extractor converting public URLs, PDFs, and assets into production W3C design tokens, WCAG 2.1 verified contrast palettes, and zero-runtime-drift code.
        </p>
        <div class="flex flex-wrap items-center gap-2 text-[10px] text-[var(--muted)]">
          <span class="px-2 py-0.5 border border-[var(--border-subtle)]">[ NO RUNTIME LOCK-IN ]</span>
          <span class="px-2 py-0.5 border border-[var(--border-subtle)]">[ ISO 9241-391 ]</span>
          <span class="px-2 py-0.5 border border-[var(--border-subtle)]">[ ZERO TELEMETRY ]</span>
        </div>
      </div>

      <!-- Col 2: System & Tools -->
      <div class="md:col-span-3 space-y-3">
        <div class="text-[11px] font-bold tracking-[0.16em] uppercase text-[var(--foreground)]">
          // PIPELINE & TOOLS
        </div>
        <ul class="space-y-2 text-[11px] text-[var(--muted)]">
          <li>
            <a href="/" class="hover:text-[var(--foreground)] transition-colors flex items-center gap-1.5">
              <span>→</span> <span>[ EXTRACTION WORKBENCH ]</span>
            </a>
          </li>
          <li>
            <a href="/build" class="hover:text-[var(--foreground)] transition-colors flex items-center gap-1.5">
              <span>→</span> <span>[ RUNTIME BUILDER // /build ]</span>
            </a>
          </li>
          <li>
            <a href="/library" class="hover:text-[var(--foreground)] transition-colors flex items-center gap-1.5">
              <span>→</span> <span>[ SPECIMEN LIBRARY ]</span>
            </a>
          </li>
          <li>
            <a href="/compare" class="hover:text-[var(--foreground)] transition-colors flex items-center gap-1.5">
              <span>→</span> <span>[ BRAND DIFF COMPARE ]</span>
            </a>
          </li>
          <li>
            <a href="/design" class="hover:text-[var(--foreground)] transition-colors flex items-center gap-1.5">
              <span>→</span> <span>[ W3C TOKEN SPECIFICATION ]</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Architecture & Legal -->
      <div class="md:col-span-4 space-y-3">
        <div class="text-[11px] font-bold tracking-[0.16em] uppercase text-[var(--foreground)]">
          // SPECIFICATION & LEGAL
        </div>
        <ul class="space-y-2 text-[11px] text-[var(--muted)]">
          <li>
            <a href="/about" class="hover:text-[var(--foreground)] transition-colors flex items-center gap-1.5">
              <span>→</span> <span>[ ABOUT & PHILOSOPHY ]</span>
            </a>
          </li>
          <li>
            <a href="/contact" class="hover:text-[var(--foreground)] transition-colors flex items-center gap-1.5">
              <span>→</span> <span>[ CONTACT & SUPPORT DESK ]</span>
            </a>
          </li>
          <li>
            <a href="/privacy-policy" class="hover:text-[var(--foreground)] transition-colors flex items-center gap-1.5">
              <span>→</span> <span>[ PRIVACY POLICY & SUBPROCESSORS ]</span>
            </a>
          </li>
          <li>
            <a href="/terms-and-conditions" class="hover:text-[var(--foreground)] transition-colors flex items-center gap-1.5">
              <span>→</span> <span>[ TERMS & CONDITIONS // FAIR USE ]</span>
            </a>
          </li>
          <li>
            <a href="/sitemap.xml" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--foreground)] transition-colors flex items-center gap-1.5 text-[10px]">
              <span>↗</span> <span>[ XML SITEMAP INDEX ]</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Legal Disclaimer -->
    <div class="pt-8 border-t border-[var(--border-subtle)] space-y-3 font-mono-ui text-[11px] text-[var(--muted)]">
      <p class="font-editorial-body text-xs text-[var(--muted)]/80 leading-relaxed">
        Legal Notice: Brand DNA is an independent reverse-engineering instrument and token workbench. Demo extractions and presets (including Stripe, Linear, and Vercel) are showcased strictly for technical reference. Brand DNA is not affiliated with, sponsored by, or endorsed by any brand analyzed. Output design tokens remain under the context of the respective rights holders.
      </p>
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-2">
        <div>
          [ SYSTEM ARCHITECT: Girish // Brand DNA Studio ]
        </div>
        <div class="flex flex-wrap items-center gap-4 text-[10px]">
          <span>[ REACT 19 + ASTRO 5 ]</span>
          <span>•</span>
          <span>[ SUPABASE + FIRECRAWL ]</span>
          <span>•</span>
          <span>[ GEMINI 3 FLASH ]</span>
        </div>
      </div>
    </div>
  </div>
</footer>
