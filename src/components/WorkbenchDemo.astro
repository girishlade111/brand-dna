---
// Workbench simulated data presets
const defaultBrand = {
  name: "Stripe Precision System",
  url: "https://stripe.com",
  palettes: [
    { name: "Ink Sumi (Foreground)", hex: "#0A0A0A", role: "Primary / Text", luminance: "0.012", ratio: "18.2:1", badge: "AAA Pass" },
    { name: "Indigo Stripe (Brand Accent)", hex: "#635BFF", role: "Brand Primary", luminance: "0.142", ratio: "7.4:1", badge: "AA Pass" },
    { name: "Cyan Horizon (Interactive)", hex: "#00D4FF", role: "Secondary Accent", luminance: "0.584", ratio: "4.8:1", badge: "AA Pass" },
    { name: "Washi Canvas (Background)", hex: "#F4EFE6", role: "Base Canvas", luminance: "0.852", ratio: "18.2:1", badge: "AAA Pass" },
    { name: "Slate Paper (Surface)", hex: "#EDE8DE", role: "Elevated Surface", luminance: "0.803", ratio: "15.1:1", badge: "AAA Pass" },
    { name: "Hanko Crimson (Alert / CTA)", hex: "#8B1A1A", role: "Warning / Accent", luminance: "0.078", ratio: "9.2:1", badge: "AAA Pass" },
  ],
  typography: [
    { label: "Display Specimen", size: "64px", weight: "300 / Light", sample: "Economic Infrastructure for the Internet", font: "Cormorant Garamond, serif" },
    { label: "Heading Specimen", size: "32px", weight: "600 / Semibold", sample: "Millions of companies scale on modern rails.", font: "Cormorant Garamond, serif" },
    { label: "Body Copy", size: "16px", weight: "400 / Regular", sample: "Design systems are living contracts between engineering velocity and product craftsmanship.", font: "Libre Baskerville, serif" },
    { label: "Data / Code Tokens", size: "12px", weight: "700 / Monospace", sample: "--token-space-inset-4: 16px; font-feature-settings: 'cv02';", font: "Courier Prime, monospace" },
  ],
  voice: {
    archetype: "Architectural, Precise, Confident, Understated",
    keywords: ["Deterministic", "Infrastructure", "Frictionless", "Foundational", "Latency"],
    dos: [
      "Use active verbs that celebrate builder momentum.",
      "Frame technical capability in terms of unyielding reliability.",
      "Prefer sparse, elegant phrasing over bloated marketing superlatives."
    ],
    donts: [
      "Never use hollow buzzwords (e.g. 'supercharge', 'synergy').",
      "Avoid conversational fluff; maintain institutional gravitas."
    ],
    sampleHeadline: "Global financial plumbing, simplified to a single keystroke."
  }
};
---

<section id="workbench" class="py-16 md:py-24 border-b border-[var(--border-subtle)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 pb-4 border-b border-[var(--border-subtle)]">
      <div>
        <div class="font-mono-ui text-xs text-[var(--muted)] uppercase tracking-[0.20em] mb-2">
          // LIVE INTERACTIVE WORKBENCH
        </div>
        <h2 class="font-display text-4xl sm:text-5xl text-[var(--foreground)] tracking-[-0.01em]">
          Simulated Extraction Engine
        </h2>
      </div>
      <div class="mt-4 md:mt-0 font-mono-ui text-xs text-[var(--muted)] flex flex-col md:items-end gap-1.5">
        <div class="flex items-center gap-3">
          <span class="inline-block w-2 h-2 bg-emerald-600 animate-pulse"></span>
          <span>STREAMING TOKENS FOR: <strong class="text-[var(--foreground)]">stripe.com</strong></span>
        </div>
        <div class="text-[10px] tracking-wider uppercase text-[var(--muted)] opacity-80">
          Demo extractions only — not affiliated with or endorsed by the brands shown.
        </div>
      </div>
    </div>

    <!-- Workbench Window Frame (0px border radius, sharp surgical frame) -->
    <div class="border border-[var(--border)] bg-[var(--surface-raised)] shadow-sm">
      <!-- Workbench Tabs Bar -->
      <div class="flex flex-wrap items-center justify-between border-b border-[var(--border)] bg-[var(--surface)] text-[11px] font-mono-ui">
        <!-- Accessible Tablist -->
        <div
          role="tablist"
          aria-label="Workbench components"
          class="flex flex-wrap items-center"
        >
          <button
            type="button"
            role="tab"
            id="workbench-tab-palette"
            aria-selected="true"
            aria-controls="tab-palette"
            tabindex="0"
            class="workbench-tab-btn active px-4 py-3 border-r border-[var(--border)] tracking-[0.14em] uppercase bg-[var(--foreground)] text-[var(--background)] font-bold transition-colors focus:outline-none focus-visible:outline-2 focus-visible:outline-[#8B1A1A] focus-visible:outline-offset-[-2px] focus-visible:z-10"
            data-tab="palette"
          >
            [ 01. PALETTE & CONTRAST ]
          </button>
          <button
            type="button"
            role="tab"
            id="workbench-tab-typography"
            aria-selected="false"
            aria-controls="tab-typography"
            tabindex="-1"
            class="workbench-tab-btn px-4 py-3 border-r border-[var(--border)] tracking-[0.14em] uppercase text-[var(--foreground)] hover:bg-[var(--foreground)] hover:text-[var(--background)] font-bold transition-colors focus:outline-none focus-visible:outline-2 focus-visible:outline-[#8B1A1A] focus-visible:outline-offset-[-2px] focus-visible:z-10"
            data-tab="typography"
          >
            [ 02. TYPOGRAPHY ]
          </button>
          <button
            type="button"
            role="tab"
            id="workbench-tab-logo"
            aria-selected="false"
            aria-controls="tab-logo"
            tabindex="-1"
            class="workbench-tab-btn px-4 py-3 border-r border-[var(--border)] tracking-[0.14em] uppercase text-[var(--foreground)] hover:bg-[var(--foreground)] hover:text-[var(--background)] font-bold transition-colors focus:outline-none focus-visible:outline-2 focus-visible:outline-[#8B1A1A] focus-visible:outline-offset-[-2px] focus-visible:z-10"
            data-tab="logo"
          >
            [ 03. LOGO STUDIO ]
          </button>
          <button
            type="button"
            role="tab"
            id="workbench-tab-voice"
            aria-selected="false"
            aria-controls="tab-voice"
            tabindex="-1"
            class="workbench-tab-btn px-4 py-3 border-r border-[var(--border)] tracking-[0.14em] uppercase text-[var(--foreground)] hover:bg-[var(--foreground)] hover:text-[var(--background)] font-bold transition-colors focus:outline-none focus-visible:outline-2 focus-visible:outline-[#8B1A1A] focus-visible:outline-offset-[-2px] focus-visible:z-10"
            data-tab="voice"
          >
            [ 04. BRAND VOICE ]
          </button>
          <button
            type="button"
            role="tab"
            id="workbench-tab-tokens"
            aria-selected="false"
            aria-controls="tab-tokens"
            tabindex="-1"
            class="workbench-tab-btn px-4 py-3 tracking-[0.14em] uppercase text-[var(--foreground)] hover:bg-[var(--foreground)] hover:text-[var(--background)] font-bold transition-colors focus:outline-none focus-visible:outline-2 focus-visible:outline-[#8B1A1A] focus-visible:outline-offset-[-2px] focus-visible:z-10"
            data-tab="tokens"
          >
            [ 05. DESIGN TOKENS ]
          </button>
        </div>

        <!-- Specimen Canvas Theme Switcher -->
        <div class="flex items-center gap-1 px-3 py-2 border-t md:border-t-0 md:border-l border-[var(--border)]">
          <span class="text-[10px] text-[var(--muted)] mr-2 select-none uppercase tracking-wider">
            CANVAS THEME:
          </span>
          <button
            type="button"
            id="canvas-btn-washi"
            class="canvas-theme-btn active px-2 py-0.5 border border-[#8B1A1A] bg-[#F4EFE6] text-[#0A0A0A] font-bold text-[10px] transition-colors"
            data-theme="washi"
          >
            [ WASHI (#F4EFE6) ]
          </button>
          <button
            type="button"
            id="canvas-btn-midnight"
            class="canvas-theme-btn px-2 py-0.5 border border-[var(--border-subtle)] text-[var(--muted)] hover:text-[var(--foreground)] text-[10px] transition-colors"
            data-theme="midnight"
          >
            [ MIDNIGHT (#0A0A0A) ]
          </button>
        </div>
      </div>

      <!-- Tab 1: Palette & Contrast Matrix -->
      <div
        id="tab-palette"
        role="tabpanel"
        aria-labelledby="workbench-tab-palette"
        tabindex="0"
        class="workbench-content p-6 sm:p-8 focus:outline-none focus-visible:outline-2 focus-visible:outline-[#8B1A1A]"
      >
        <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h3 class="font-display text-2xl text-[var(--foreground)] mb-1">
              Semantic Swatches & WCAG Contrast Matrix
            </h3>
            <p class="font-editorial-body text-xs text-[var(--muted)]">
              Audited against ISO 9241-391 and WCAG 2.1 relative luminance thresholds.
            </p>
          </div>
          <div class="font-mono-ui text-[11px] text-[var(--muted)] flex items-center gap-2">
            <span class="px-2 py-0.5 border border-[var(--border-subtle)] bg-[var(--background)]">[ 100% WCAG COMPLIANT ]</span>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-4">
          {defaultBrand.palettes.map((p) => (
            <div class="border border-[var(--border)] p-4 bg-[var(--background)] transition-all hover:-translate-y-0.5 group">
              <div
                class="w-full h-20 mb-3 border border-[var(--border-subtle)] flex items-end p-2 relative overflow-hidden"
                style={`background-color: ${p.hex};`}
              >
                <span class="font-mono-ui text-[9px] px-1 bg-black/75 text-white">
                  L: {p.luminance}
                </span>
              </div>
              <div class="font-mono-ui text-xs font-bold text-[var(--foreground)] truncate">{p.name}</div>
              <div class="font-mono-ui text-xs text-[var(--muted)] group-hover:text-[var(--foreground)] transition-colors">
                {p.hex}
              </div>
              <div class="mt-2 pt-2 border-t border-[var(--border-subtle)] flex items-center justify-between font-mono-ui text-[10px]">
                <span class="text-[var(--muted)]">{p.role}</span>
                <span class="text-[var(--accent)] font-bold">{p.badge}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Tab 2: Computed Typography Specimen -->
      <div
        id="tab-typography"
        role="tabpanel"
        aria-labelledby="workbench-tab-typography"
        tabindex="0"
        class="workbench-content hidden p-6 sm:p-8 focus:outline-none focus-visible:outline-2 focus-visible:outline-[#8B1A1A]"
      >
        <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h3 class="font-display text-2xl text-[var(--foreground)] mb-1">
              Extracted Type Scale & Dynamic Hierarchy
            </h3>
            <p class="font-editorial-body text-xs text-[var(--muted)]">
              Computed styles captured from live DOM render tree.
            </p>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-mono-ui text-xs text-[var(--muted)] select-none">SAMPLE:</span>
            <input
              id="specimen-custom-input"
              type="text"
              value="The invisible instrument of modern software craft."
              class="border border-[var(--border-subtle)] px-3 py-1 font-mono-ui text-xs bg-[var(--background)] text-[var(--foreground)] focus:outline-none w-64"
            />
          </div>
        </div>

        <div class="space-y-6">
          {defaultBrand.typography.map((t) => (
            <div class="border-b border-[var(--border-subtle)] pb-4">
              <div class="flex items-center justify-between font-mono-ui text-[11px] text-[var(--muted)] mb-2">
                <span>{t.label} — {t.font} ({t.size} / {t.weight})</span>
                <span class="uppercase">[ EXTRACTED COMPONENT ]</span>
              </div>
              <div
                style={`font-family: ${t.font}; font-size: ${t.size}; font-weight: ${t.weight.includes('600') ? 600 : t.weight.includes('700') ? 700 : t.weight.includes('300') ? 300 : 400};`}
                class="typography-specimen-text text-[var(--foreground)] leading-tight truncate"
              >
                {t.sample}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Tab 3: Logo Studio Variants -->
      <div
        id="tab-logo"
        role="tabpanel"
        aria-labelledby="workbench-tab-logo"
        tabindex="0"
        class="workbench-content hidden p-6 sm:p-8 focus:outline-none focus-visible:outline-2 focus-visible:outline-[#8B1A1A]"
      >
        <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h3 class="font-display text-2xl text-[var(--foreground)] mb-1">
              Extracted Vector Logotype & Isolated Mark
            </h3>
            <p class="font-editorial-body text-xs text-[var(--muted)]">
              Scraped from DOM inline SVGs and header assets. Tested across light, dark, and monochrome contexts.
            </p>
          </div>
          <div class="flex items-center gap-1 font-mono-ui text-xs">
            <button
              type="button"
              class="logo-variant-btn btn-bracketed btn-bracketed-primary text-[10px] py-1 px-2.5"
              data-variant="light"
            >
              <span>[ WASHI LIGHT ]</span>
            </button>
            <button
              type="button"
              class="logo-variant-btn btn-bracketed text-[10px] py-1 px-2.5"
              data-variant="dark"
            >
              <span>[ MIDNIGHT DARK ]</span>
            </button>
            <button
              type="button"
              class="logo-variant-btn btn-bracketed text-[10px] py-1 px-2.5"
              data-variant="mono"
            >
              <span>[ MONOCHROME ]</span>
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div id="logo-card-1" class="border border-[var(--border)] p-8 flex flex-col items-center justify-center min-h-[220px] bg-[#F4EFE6] text-[#0A0A0A] transition-colors duration-200">
            <svg class="w-52 h-16 fill-current mb-4" viewBox="0 0 120 40">
              <path d="M12 12c-4 0-7 2-7 6s3 5 8 7c6 2 9 4 9 9 0 5-4 8-10 8-5 0-9-2-11-5l3-3c2 2 5 4 8 4 3 0 5-1 5-4 0-2-2-4-7-6-5-2-10-4-10-9 0-5 4-8 10-8 4 0 8 2 10 4l-3 3c-2-2-4-3-7-3zm20-8h4v34h-4zm14 9h4v25h-4zm15 0h4v4h-4zm0 6h4v19h-4zm15-6h4v3h-4v7c0 3 1 4 4 4 1 0 2 0 3-1l1 3c-1 1-3 1-5 1-4 0-7-2-7-7v-7h-4v-3h4v-5h4v5zm16 0h4v3h-4v22h-4zm12 0c6 0 10 4 10 13 0 1 0 2-1 2h-15c0 5 3 7 7 7 3 0 5-1 6-3l3 2c-2 3-5 5-9 5-8 0-13-5-13-13 0-7 5-13 12-13zm-6 9h11c0-4-2-6-5-6s-5 2-6 6z" />
            </svg>
            <span class="font-mono-ui text-[10px] tracking-[0.2em] opacity-60">[ WORDMARK & LOGOTYPE — SVG ]</span>
          </div>

          <div id="logo-card-2" class="border border-[var(--border)] p-8 flex flex-col items-center justify-center min-h-[220px] bg-[#EDE8DE] text-[#0A0A0A] transition-colors duration-200">
            <div class="w-16 h-16 border-2 border-current flex items-center justify-center font-display text-4xl italic font-bold mb-4">
              S
            </div>
            <span class="font-mono-ui text-[10px] tracking-[0.2em] opacity-60">[ EXTRACTED STANDALONE MARK — GLYPH ]</span>
          </div>
        </div>
      </div>

      <!-- Tab 4: Brand Voice Archetype -->
      <div
        id="tab-voice"
        role="tabpanel"
        aria-labelledby="workbench-tab-voice"
        tabindex="0"
        class="workbench-content hidden p-6 sm:p-8 focus:outline-none focus-visible:outline-2 focus-visible:outline-[#8B1A1A]"
      >
        <div class="mb-6">
          <h3 class="font-display text-2xl text-[var(--foreground)] mb-1">
            Brand Voice & Editorial Vocabulary Synthesis
          </h3>
          <p class="font-editorial-body text-xs text-[var(--muted)]">
            Synthesized by Gemini 3 Flash scanning domain prose, companion pages (/about, /terms), and marketing copy.
          </p>
          <!-- Trademark / Affiliation Disclaimer in Brand Voice Output -->
          <div class="mt-2 font-mono-ui text-[10px] text-[var(--muted)] tracking-wider uppercase flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 bg-[var(--accent)] inline-block select-none"></span>
            <span>Demo extractions only — not affiliated with or endorsed by the brands shown.</span>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Voice Attributes -->
          <div class="border border-[var(--border-subtle)] p-6 bg-[var(--background)]">
            <div class="font-mono-ui text-[11px] text-[var(--muted)] uppercase tracking-wider mb-2">[ ARCHETYPE & TONE ]</div>
            <div class="font-display text-2xl text-[var(--foreground)] mb-4">
              {defaultBrand.voice.archetype}
            </div>

            <div class="font-mono-ui text-[11px] text-[var(--muted)] uppercase tracking-wider mb-2">[ DOMAIN VOCABULARY ]</div>
            <div class="flex flex-wrap gap-2 mb-6">
              {defaultBrand.voice.keywords.map((k) => (
                <span class="font-mono-ui text-xs px-2 py-1 border border-[var(--border-subtle)] bg-[var(--surface)] text-[var(--foreground)]">
                  {k}
                </span>
              ))}
            </div>

            <div class="font-mono-ui text-[11px] text-[var(--muted)] uppercase tracking-wider mb-2">[ SYNTHESIZED LEAD COPY ]</div>
            <blockquote class="font-editorial-body italic text-base text-[var(--foreground)] border-l-2 border-[var(--accent)] pl-3 py-1 mb-2">
              "{defaultBrand.voice.sampleHeadline}"
            </blockquote>
            <div class="font-mono-ui text-[9px] text-[var(--muted)] uppercase">
              Specimen synthesized based on public copy styles. Not endorsed by brand owner.
            </div>
          </div>

          <!-- Strict Dos and Don'ts -->
          <div class="border border-[var(--border-subtle)] p-6 bg-[var(--background)] flex flex-col justify-between">
            <div>
              <div class="font-mono-ui text-[11px] text-emerald-700 dark:text-emerald-400 uppercase tracking-wider mb-2">
                [ ✓ COPYWRITING MANDATES (DO) ]
              </div>
              <ul class="space-y-2 mb-6 font-editorial-body text-xs text-[var(--foreground)]">
                {defaultBrand.voice.dos.map((d) => (
                  <li class="flex items-start gap-2">
                    <span class="font-mono-ui text-emerald-600 font-bold">›</span>
                    <span>{d}</span>
                  </li>
                ))}
              </ul>

              <div class="font-mono-ui text-[11px] text-[var(--accent)] uppercase tracking-wider mb-2">
                [ ✕ ANTI-PATTERNS & BANNED TERMS (DON'T) ]
              </div>
              <ul class="space-y-2 font-editorial-body text-xs text-[var(--foreground)]">
                {defaultBrand.voice.donts.map((d) => (
                  <li class="flex items-start gap-2">
                    <span class="font-mono-ui text-[var(--accent)] font-bold">✕</span>
                    <span>{d}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Tab 5: W3C Design Tokens Tree -->
      <div
        id="tab-tokens"
        role="tabpanel"
        aria-labelledby="workbench-tab-tokens"
        tabindex="0"
        class="workbench-content hidden p-6 sm:p-8 focus:outline-none focus-visible:outline-2 focus-visible:outline-[#8B1A1A]"
      >
        <div class="mb-4 flex items-center justify-between">
          <h3 class="font-display text-2xl text-[var(--foreground)]">
            W3C Design Tokens Spec Specification
          </h3>
          <span class="font-mono-ui text-[11px] text-[var(--muted)]">[ FORMAT: W3C DTCG SPEC ]</span>
        </div>
        <pre class="bg-[var(--background)] p-4 sm:p-6 border border-[var(--border-subtle)] font-mono-ui text-xs text-[var(--foreground)] overflow-x-auto leading-relaxed select-all">
{`{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "ink": { "$value": "#0A0A0A", "$type": "color" },
    "washi": { "$value": "#F4EFE6", "$type": "color" },
    "brand": { "$value": "#635BFF", "$type": "color" },
    "accent": { "$value": "#8B1A1A", "$type": "color" }
  },
  "spacing": {
    "scale-1": { "$value": "4px", "$type": "dimension" },
    "scale-2": { "$value": "8px", "$type": "dimension" },
    "scale-4": { "$value": "16px", "$type": "dimension" },
    "scale-8": { "$value": "32px", "$type": "dimension" },
    "scale-16": { "$value": "64px", "$type": "dimension" }
  },
  "elevation": {
    "flat": { "$value": "none", "$type": "shadow" },
    "paper": { "$value": "0 1px 3px rgba(10,10,10,0.06)", "$type": "shadow" }
  },
  "border": {
    "width": { "$value": "1px", "$type": "dimension" },
    "radius": { "$value": "0px", "$type": "dimension" }
  }
}`}
        </pre>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Tab switching logic with ARIA & keyboard arrow support
  const tabButtons = Array.from(document.querySelectorAll('.workbench-tab-btn'));
  const tabContents = document.querySelectorAll('.workbench-content');

  const activateWorkbenchTab = (btn) => {
    const target = btn.getAttribute('data-tab');

    tabButtons.forEach((b) => {
      b.classList.remove('bg-[var(--foreground)]', 'text-[var(--background)]', 'active');
      b.classList.add('text-[var(--foreground)]');
      b.setAttribute('aria-selected', 'false');
      b.setAttribute('tabindex', '-1');
    });

    btn.classList.add('bg-[var(--foreground)]', 'text-[var(--background)]', 'active');
    btn.classList.remove('text-[var(--foreground)]');
    btn.setAttribute('aria-selected', 'true');
    btn.setAttribute('tabindex', '0');
    btn.focus();

    tabContents.forEach((c) => c.classList.add('hidden'));
    const activeContent = document.getElementById(`tab-${target}`);
    if (activeContent) activeContent.classList.remove('hidden');
  };

  tabButtons.forEach((btn, index) => {
    btn.addEventListener('click', () => activateWorkbenchTab(btn));

    btn.addEventListener('keydown', (e) => {
      let targetIndex = null;
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        targetIndex = (index + 1) % tabButtons.length;
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        targetIndex = (index - 1 + tabButtons.length) % tabButtons.length;
      } else if (e.key === 'Home') {
        e.preventDefault();
        targetIndex = 0;
      } else if (e.key === 'End') {
        e.preventDefault();
        targetIndex = tabButtons.length - 1;
      }

      if (targetIndex !== null) {
        activateWorkbenchTab(tabButtons[targetIndex]);
      }
    });
  });

  // Specimen live input updating
  const specimenInput = document.getElementById('specimen-custom-input');
  if (specimenInput) {
    specimenInput.addEventListener('input', (e) => {
      const val = e.target.value;
      document.querySelectorAll('.typography-specimen-text').forEach((el) => {
        el.textContent = val || 'The invisible instrument of modern software craft.';
      });
    });
  }

  // Logo variant buttons
  const logoButtons = document.querySelectorAll('.logo-variant-btn');
  const card1 = document.getElementById('logo-card-1');
  const card2 = document.getElementById('logo-card-2');

  logoButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      logoButtons.forEach((b) => b.classList.remove('btn-bracketed-primary'));
      btn.classList.add('btn-bracketed-primary');
      const variant = btn.getAttribute('data-variant');

      if (variant === 'dark') {
        if (card1) { card1.style.backgroundColor = '#0A0A0A'; card1.style.color = '#F4EFE6'; }
        if (card2) { card2.style.backgroundColor = '#141414'; card2.style.color = '#F4EFE6'; }
      } else if (variant === 'mono') {
        if (card1) { card1.style.backgroundColor = '#FFFFFF'; card1.style.color = '#000000'; }
        if (card2) { card2.style.backgroundColor = '#F0F0F0'; card2.style.color = '#000000'; }
      } else {
        if (card1) { card1.style.backgroundColor = '#F4EFE6'; card1.style.color = '#0A0A0A'; }
        if (card2) { card2.style.backgroundColor = '#EDE8DE'; card2.style.color = '#0A0A0A'; }
      }
    });
  });

  // Specimen Canvas Theme Switcher (Washi / Midnight)
  const washiBtn = document.getElementById('canvas-btn-washi');
  const midnightBtn = document.getElementById('canvas-btn-midnight');
  const palettePanel = document.getElementById('tab-palette');
  const typePanel = document.getElementById('tab-typography');

  if (washiBtn && midnightBtn) {
    washiBtn.addEventListener('click', () => {
      washiBtn.className = 'canvas-theme-btn active px-2 py-0.5 border border-[#8B1A1A] bg-[#F4EFE6] text-[#0A0A0A] font-bold text-[10px] transition-colors';
      midnightBtn.className = 'canvas-theme-btn px-2 py-0.5 border border-[var(--border-subtle)] text-[var(--muted)] hover:text-[var(--foreground)] text-[10px] transition-colors';
      if (palettePanel) {
        palettePanel.style.backgroundColor = '#F4EFE6';
        palettePanel.style.color = '#0A0A0A';
      }
      if (typePanel) {
        typePanel.style.backgroundColor = '#F4EFE6';
        typePanel.style.color = '#0A0A0A';
      }
    });

    midnightBtn.addEventListener('click', () => {
      midnightBtn.className = 'canvas-theme-btn active px-2 py-0.5 border border-[#8B1A1A] bg-[#0A0A0A] text-[#F4EFE6] font-bold text-[10px] transition-colors';
      washiBtn.className = 'canvas-theme-btn px-2 py-0.5 border border-[var(--border-subtle)] text-[var(--muted)] hover:text-[var(--foreground)] text-[10px] transition-colors';
      if (palettePanel) {
        palettePanel.style.backgroundColor = '#0A0A0A';
        palettePanel.style.color = '#F4EFE6';
      }
      if (typePanel) {
        typePanel.style.backgroundColor = '#0A0A0A';
        typePanel.style.color = '#F4EFE6';
      }
    });
  }
</script>
